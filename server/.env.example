# ─── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Comma-separated dashboard origins allowed by CORS. The first one is used
# for links in owner emails and OAuth redirects.
DASHBOARD_URL=http://localhost:5173

# ─── Supabase (required) ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service-role key. Server-side only; never ship it to the browser.
SUPABASE_SERVICE_KEY=

# ─── Vapi ─────────────────────────────────────────────────────────────
# Shared secret Vapi sends as X-Vapi-Secret (or Authorization: Bearer).
# Required when NODE_ENV=production. Generate: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=
# Only used by `npm run setup` to buy phone numbers.
VAPI_API_KEY=
# Public URL of this server, used by `npm run setup` as the webhook default.
PUBLIC_SERVER_URL=

# Voice agent. The model must be one Vapi supports for provider "anthropic".
VOICE_MODEL=claude-haiku-5-5
VOICE_PROVIDER=vapi
VOICE_ID=Clara

# ─── Post-call analysis (optional) ────────────────────────────────────
# Enables Claude summaries, sentiment and follow-up detection.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-haiku-5-5

# ─── Google Calendar (optional; enables live booking) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# 32-byte key for encrypting OAuth tokens at rest. Required in production
# when Google is enabled. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# HMAC key for OAuth state. Defaults to SUPABASE_SERVICE_KEY.
OAUTH_STATE_SECRET=

# ─── Owner notifications (optional) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number, or a Messaging Service SID (MG...).
TWILIO_PHONE_NUMBER=

RESEND_API_KEY=
# Must be on a domain verified in Resend.
NOTIFICATION_FROM_EMAIL=VoiceDesk <alerts@your-domain.com>
