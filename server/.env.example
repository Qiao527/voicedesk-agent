# Server
PORT=3001
NODE_ENV=development
DASHBOARD_URL=http://localhost:5173

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Vapi (required)
VAPI_API_KEY=your-vapi-api-key
VAPI_WEBHOOK_SECRET=your-webhook-secret

# Anthropic (required)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Calendar (optional — needed for appointment booking)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Secret used to HMAC-sign OAuth `state` tokens. If unset, falls back to
# SUPABASE_SERVICE_KEY. Set a dedicated secret in production so rotating
# Supabase keys doesn't invalidate in-flight auth flows.
OAUTH_STATE_SECRET=change-me-to-a-long-random-string

# Twilio SMS (optional — needed for owner notifications)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Resend Email (optional)
RESEND_API_KEY=your-resend-key
