{
  "name": "voicedesk-server",
  "version": "1.0.0",
  "description": "Webhook server for VoiceDesk AI: Vapi call handling, Google Calendar booking, Claude post-call analysis.",
  "author": "Zaiqiao Long (https://github.com/Qiao527)",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo:call": "tsx src/scripts/demo-call.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "setup": "tsx src/scripts/setup-business.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^188.0.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qiao527/voicedesk-agent.git",
    "directory": "server"
  },
  "homepage": "https://github.com/Qiao527/voicedesk-agent#readme",
  "bugs": {
    "url": "https://github.com/Qiao527/voicedesk-agent/issues"
  }
}
