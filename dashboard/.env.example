# Supabase project (Settings -> API). The anon key is safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server origin in production, e.g. https://your-server.example.com
# In local dev the Vite proxy forwards /api to http://localhost:3001.
VITE_API_URL=

# Run on built-in sample data with no backend (also: npm run dev:demo).
# VITE_DEMO_MODE=true
